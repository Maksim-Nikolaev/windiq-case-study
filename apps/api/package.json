{
  "name": "@windiq/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node src/main.ts",
    "migrate": "node src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "openapi": "node src/write-openapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@hono/swagger-ui": "0.6.2",
    "@hono/zod-openapi": "1.6.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "pino": "10.4.0",
    "postgres": "4.1.1",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@windiq/fake-upstream": "workspace:*",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
