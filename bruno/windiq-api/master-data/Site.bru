meta {
  name: Site
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/site
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.id: isString
}

docs {
  Shear exponent, the three loss fractions and the total uncertainty. The version and updated_at fields show a change of the data set.
}
