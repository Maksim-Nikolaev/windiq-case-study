meta {
  name: Turbine
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/turbine
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.id: isString
}

docs {
  Hub height, cut-in and cut-out speed, and the power curve in steps of 1 m/s. The version and updated_at fields show a change of the data set.
}
